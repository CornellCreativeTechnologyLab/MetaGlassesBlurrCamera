<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill"
            android:contentDescription="Back"
            android:padding="9dp"
            android:src="@drawable/ic_chevron_left" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.2"
                android:text="BLURR GALLERY"
                android:textColor="#80FFFFFF"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/gallery_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your captures"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_share"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill"
            android:contentDescription="Share"
            android:padding="10dp"
            android:src="@drawable/ic_share" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ===================== REVIEW CONTENT (has captures) ===================== -->
        <LinearLayout
            android:id="@+id/review_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Export state badges -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/badge_watermark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_white"
                    android:drawableStart="@drawable/ic_lock"
                    android:drawablePadding="6dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="7dp"
                    android:text="Watermarked · download off"
                    android:textColor="#111111"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/badge_accessible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill"
                    android:drawableStart="@drawable/ic_unlock"
                    android:drawablePadding="6dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="7dp"
                    android:text="Accessible"
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Player -->
            <FrameLayout
                android:id="@+id/player"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginHorizontal="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/preview_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Selected capture"
                    android:scaleType="centerCrop" />

                <!-- Real video playback surface. Hidden for photos and until the user presses play. -->
                <VideoView
                    android:id="@+id/preview_video"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Selected video"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/select_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="9dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/select_count"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0 of 0 faces blurred · tap to toggle"
                        android:textColor="#CCFFFFFF"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/btn_select_done"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Done"
                        android:textColor="@color/blurr_accent"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/face0"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_marginStart="52dp"
                    android:layout_marginTop="150dp"
                    android:background="@drawable/bg_face_box_white"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/check0"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="-6dp"
                        android:background="@drawable/bg_check_badge"
                        android:padding="3dp"
                        android:src="@drawable/ic_check"
                        android:visibility="gone" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/face1"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="148dp"
                    android:background="@drawable/bg_face_box_accent"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/check1"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="-6dp"
                        android:background="@drawable/bg_check_badge"
                        android:padding="3dp"
                        android:src="@drawable/ic_check" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/face2"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="155dp"
                    android:layout_marginEnd="60dp"
                    android:background="@drawable/bg_face_box_white"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/check2"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="-6dp"
                        android:background="@drawable/bg_check_badge"
                        android:padding="3dp"
                        android:src="@drawable/ic_check"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/watermark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="12dp"
                    android:letterSpacing="0.3"
                    android:rotation="-4"
                    android:text="BLURR · PREVIEW"
                    android:textColor="#B3FFFFFF"
                    android:textSize="10sp" />

                <ImageView
                    android:id="@+id/btn_play"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_pill"
                    android:contentDescription="Play"
                    android:padding="18dp"
                    android:src="@drawable/ic_play"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Primary actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp">

                <TextView
                    android:id="@+id/btn_select_faces"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_square"
                    android:drawableStart="@drawable/ic_users"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Select faces"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_blur_all"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_accent"
                    android:drawableStart="@drawable/ic_sparkles"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Blur em all"
                    android:textColor="#111111"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Bottom thumbnail strip of all captures -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/strip_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- ===================== EMPTY STATE ===================== -->
        <LinearLayout
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:alpha="0.35"
                android:contentDescription="Empty"
                android:src="@drawable/ic_images" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Your Blurr gallery is empty"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Photos and videos you capture will appear here."
                android:textColor="#80FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>